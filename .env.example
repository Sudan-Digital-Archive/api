# Database
POSTGRES_URL="postgresql://archivist:test@localhost/sudan_archives"

# Email (Postmark)
ARCHIVE_SENDER_EMAIL="archive@example.com"
POSTMARK_API_BASE="https://api.postmarkapp.com"
POSTMARK_API_KEY="your-postmark-api-key"

# Browsertrix
BROWSERTRIX_USERNAME="your-username"
BROWSERTRIX_PASSWORD="your-password"
BROWSERTRIX_ORGID="your-org-id"
BROWSERTRIX_BROWSERTRIX_URL="https://your-browsertrix-instance.com"

# Auth
JWT_COOKIE_DOMAIN="localhost"
JWT_EXPIRY_HOURS="168"

# CORS
CORS_URL="http://localhost:5173"

# Server
LISTENER_ADDRESS="0.0.0.0:5001"

# S3/DigitalOcean Spaces
DO_SPACES_ENDPOINT_URL="https://your-space.region.digitaloceanspaces.com"
DO_SPACES_REGION="region"
DO_SPACES_BUCKET="your-bucket"
DO_SPACES_ACCESS_KEY="your-access-key"
DO_SPACES_SECRET_KEY="your-secret-key"
S3_OPERATION_TIMEOUT="30"
S3_OPERATION_ATTEMPT_TIMEOUT="10"
S3_CONNECT_TIMEOUT="3"

# Presigned URL expiry
PRESIGNED_PUT_URL_EXPIRY_SECONDS="900"
PRESIGNED_GET_URL_EXPIRY_SECONDS="3600"

# Optional: Disable SQL logging (default: true)
DISABLE_SQL_LOGGING="true"

# Optional: Mock external services for development without external dependencies
# Set to "true" to use in-memory implementations
MOCK_BROWSERTRIX="false"
MOCK_S3="false"
MOCK_POSTMARK="false"
MOCK_AUTH="false"
MOCK_DB="false"

# Optional: Disable features for local development
ENABLE_RATE_LIMITING="true"
ENABLE_TRACING="true"